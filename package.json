{
  "name": "ai-report-tool",
  "version": "0.3.6",
  "description": "AI report tool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexttopsu/ai-report-tool.git"
  },
  "bugs": {
    "url": "https://github.com/nexttopsu/ai-report-tool/issues"
  },
  "homepage": "https://github.com/nexttopsu/ai-report-tool#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "bin": {
    "ai-report": "./dist/cli/index.js",
    "ai-report-mcp": "./dist/mcp/server.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "dev": "tsx example.ts",
    "build": "tsup",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:mcp": "tsx scripts/mcp-smoke.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai-report-tool",
    "report",
    "tool"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
